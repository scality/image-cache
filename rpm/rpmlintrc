# Data package: a systemd service/timer plus a helper script; no docs or man pages.
addFilter(r"no-documentation")
addFilter(r"no-manual-page-for-binary")
# The version is injected at build time (_VERSION_ placeholder), so the static
# %changelog entry version may differ from the built package version.
addFilter(r"incoherent-version-in-changelog")
# "Pre-load" trips the dictionary but is correct English.
addFilter(r"spelling-error Summary\(en_US\) Pre")
# The repository is private until it is open-sourced, so rpmlint cannot reach
# the URL yet. Remove this filter once the repository is public.
addFilter(r"invalid-url URL")
# imagecachectl ships a single statically linked Go binary: that is the point,
# it must run on a node that has nothing else, and there is no debuginfo
# package to strip into.
addFilter(r"statically-linked-binary")
addFilter(r"unstripped-binary-or-object")
# "kubelet" trips the dictionary but is the name of the thing.
addFilter(r"spelling-error %description -l en_US kubelet")
# Neither package compiles anything at rpmbuild time: one ships a script, the
# other installs a binary the release workflow already built. There is nothing
# to unpack and nothing to compile, so both sections are absent on purpose.
addFilter(r"no-%prep-section")
addFilter(r"no-%build-section")
